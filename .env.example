# Скопируйте этот файл в .env и укажите реальные значения.
# Параметры со знаком * обязательны; параметры без * — опциональны.

# * Ключ API биржи
EXCH_API_KEY="your_exchange_api_key"
# * Секрет API биржи
EXCH_API_SECRET="your_exchange_api_secret"
# Токен Telegram-бота
TG_BOT_TOKEN="your_telegram_bot_token"
# Идентификатор пользователя Telegram
TG_USER_ID="12345"
# * Пользователь PostgreSQL
DB_USER="your_postgres_user"
# * Пароль PostgreSQL
DB_PASSWORD="your_postgres_password"
